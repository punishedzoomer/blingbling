{
  "manifest_version": 3,
  "name": "Bling Bling Companion",
  "version": "1.0.0",
  "description": "Companion extension for capturing webpage content and sending it to Bling Bling.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capture Snippet",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' ws://localhost:14444 ws://127.0.0.1:14444; script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["html2canvas.min.js", "content.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Capture Snippet"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion2@blingbling.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
