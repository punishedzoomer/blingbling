{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bling Bling",
  "version": "0.1.0",
  "identifier": "com.notosansdiary.blingbling",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Bling Bling",
        "label": "app-shell",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      },
      {
        "title": "BlingBling",
        "label": "main",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "title": "Settings",
        "label": "settings",
        "width": 480,
        "height": 500,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "title": "Conversation History",
        "label": "history",
        "width": 380,
        "height": 650,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "title": "Snip",
        "label": "snip",
        "width": 1920,
        "height": 1080,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "title": "Tutorial",
        "label": "tutorial",
        "width": 500,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "title": "Notebook",
        "label": "notebook",
        "width": 480,
        "height": 620,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        "blingbling"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}